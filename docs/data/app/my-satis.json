usercontent.com/kLNSM16xOEOdO8ZWE7csbvEdnalCdiAWcx3gsgMs4kE7iCLwubZq9Le1JQITOoZyIxjtlSjs9LMTszeT9N5oEw","cat":"Lifestyle","rating":null,"ratings":0,"mentions":1,"users":1,"threads":1,"hn_points":0,"hn_comments":0,"submissions":0,"self_n":0,"hn_score":2.0,"first":1375463798,"last":1375463798,"show_hn":null,"n_lab":1,"pos_pct":0,"neg_pct":0,"mood":null,"quotes":[{"id":6148241,"k":"android:jp.co.lixil.remotesatis201210","type":"comment","by":"donutz","time":1375463798,"text":"Here's the app that goes along with the toilet: https://play.google.com/store/apps/details?id=jp.co.lixil.remotesatis201210&hl=en\n\nAt least the poop journal aspects shouldn't be compromised even if your toilet is :)","title":null,"story_id":6146306,"story_title":"Security disclosure about a Bluetooth toilet","story_score":98,"comments":0,"w":1.0,"u":0,"s":"neu","self":false}],"slug":"my-satis"}