 one-time purchase.\n- No subscription.","released":"2024-05-20","updated":"2026-06-16","icon":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/6e/9d/3c/6e9d3c84-ab20-8521-28c1-ee95fff005a1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg","age":"4+"},"android":null,"icon":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/6e/9d/3c/6e9d3c84-ab20-8521-28c1-ee95fff005a1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg","cat":"Productivity","rating":null,"ratings":0,"mentions":1,"users":1,"threads":1,"hn_points":1,"hn_comments":1,"submissions":1,"self_n":1,"hn_score":2.0,"first":1716258943,"last":1716258943,"show_hn":null,"n_lab":0,"pos_pct":null,"neg_pct":null,"mood":null,"quotes":[{"id":40423441,"k":"ios:6499254207","type":"story","by":"mattewwung","time":1716258943,"text":"","title":"Jiff Note, Safe and private, no ads","story_id":40423441,"story_title":"Jiff Note, Safe and private, no ads","story_score":1,"comments":1,"w":2.0,"u":-1,"s":"pos","self":true}],"slug":"jiff-note-private-notes"}