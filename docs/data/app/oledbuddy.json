nds in mind.","released":"Apr 3, 2018","updated":"2026-09-03","icon":"https://play-lh.googleusercontent.com/yJi0pEN56giTSOfJoxp_DIlYhRtMRwXFyecnV34evaW-TDZCvBjtzn1ZjnJjYXOxjJhpg7ENGdH_LSjyvv2xgg","age":"Everyone"},"icon":"https://play-lh.googleusercontent.com/yJi0pEN56giTSOfJoxp_DIlYhRtMRwXFyecnV34evaW-TDZCvBjtzn1ZjnJjYXOxjJhpg7ENGdH_LSjyvv2xgg","cat":"Utilities","rating":4.81,"ratings":404,"mentions":1,"users":1,"threads":1,"hn_points":0,"hn_comments":0,"submissions":0,"self_n":0,"hn_score":2.0,"first":1533846819,"last":1533846819,"show_hn":null,"n_lab":1,"pos_pct":100,"neg_pct":0,"mood":null,"quotes":[{"id":17728218,"k":"android:me.mikecroall.oledbuddy","type":"comment","by":"sqd","time":1533846819,"text":"I use OLEDBuddy.\nhttps://play.google.com/store/apps/details?id=me.mikecroall.oledbuddy&hl=en_US","title":null,"story_id":17726439,"story_title":"Show HN: I built OLEDify to help save battery by pure-blacking your wallpapers","story_score":49,"comments":0,"w":1.0,"u":0,"s":"pos","self":false}],"slug":"oledbuddy"}