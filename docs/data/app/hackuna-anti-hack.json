REE  \r\nWe can now enjoy the WiFi, peacefully!   \r\nShare this app if you want to grant this kind of power to your friends and families!","released":"Nov 17, 2018","updated":"2025-12-02","icon":"https://play-lh.googleusercontent.com/8aZ2v262u42M33XxF4nqhJ8rl0GjzedwA1szBr-mvVe35RTEywEtnyKHjY4FW4H_0JZoXTptfBlAL8swlzChBg","age":"Everyone"},"icon":"https://play-lh.googleusercontent.com/8aZ2v262u42M33XxF4nqhJ8rl0GjzedwA1szBr-mvVe35RTEywEtnyKHjY4FW4H_0JZoXTptfBlAL8swlzChBg","cat":"Utilities","rating":4.4,"ratings":14018,"mentions":1,"users":1,"threads":1,"hn_points":3,"hn_comments":0,"submissions":1,"self_n":0,"hn_score":4.0,"first":1542609812,"last":1542609812,"show_hn":null,"n_lab":1,"pos_pct":0,"neg_pct":0,"mood":null,"quotes":[{"id":18484580,"k":"android:org.cryptors.hackuna002","type":"story","by":"Skull09","time":1542609812,"text":"","title":"Hackuna (Super Powers Against Hackers)","story_id":18484580,"story_title":"Hackuna (Super Powers Against Hackers)","story_score":3,"comments":0,"w":3.0,"u":0,"s":"neu","self":false}],"slug":"hackuna-anti-hack"}