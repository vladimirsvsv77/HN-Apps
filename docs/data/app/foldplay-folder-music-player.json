at experience on small phones and big tablets alike.\r\n\r\nWant to help translate the app to your native language? Please go to https://abn-volk.gitlab.io/about-pnh/foldplay/translate.html","released":"Jan 4, 2018","updated":"2026-10-28","icon":"https://play-lh.googleusercontent.com/rSY9McbQ7BHihnn56BmJ_mrjv0Y1sf8JNx10iazCbZU5vsvbpoVu_xRVoMtW82dnMYazFdqE3mY1Rkv0b3XknA","age":"Everyone"},"icon":"https://play-lh.googleusercontent.com/rSY9McbQ7BHihnn56BmJ_mrjv0Y1sf8JNx10iazCbZU5vsvbpoVu_xRVoMtW82dnMYazFdqE3mY1Rkv0b3XknA","cat":"Music & Audio","rating":4.64,"ratings":7573,"mentions":1,"users":1,"threads":1,"hn_points":0,"hn_comments":0,"submissions":0,"self_n":0,"hn_score":2.0,"first":1739443356,"last":1739443356,"show_hn":null,"n_lab":1,"pos_pct":100,"neg_pct":0,"mood":null,"quotes":[{"id":43034649,"k":"android:net.pnhdroid.foldplay","type":"comment","by":"gitaarik","time":1739443356,"text":"I use Foldplay\n\nhttps://play.google.com/store/apps/details?id=net.pnhdroid.foldplay","title":null,"story_id":43024961,"story_title":"DeaDBeeF: The Ultimate Music Player","story_score":174,"comments":0,"w":1.0,"u":0,"s":"pos","self":false}],"slug":"foldplay-folder-music-player"}