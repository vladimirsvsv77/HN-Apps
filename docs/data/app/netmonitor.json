er Experience\n• Supported Dark Mode and Tinted Mode.\n• Optimized for iOS 18 and iPhone 16 series.\n• Optimized for iPadOS.\n\nPrivacy Matters\nNetMonitor+ does not collect, upload and share any of your data.","released":"2017-09-28","updated":"2025-01-02","icon":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/81/64/a8/8164a8b1-d07c-ba52-0c93-60b0898479f3/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg","age":"4+"},"android":null,"icon":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/81/64/a8/8164a8b1-d07c-ba52-0c93-60b0898479f3/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg","cat":"Utilities","rating":4.46,"ratings":35,"mentions":1,"users":1,"threads":1,"hn_points":2,"hn_comments":0,"submissions":1,"self_n":1,"hn_score":1.58,"first":1513941329,"last":1513941329,"show_hn":{"time":1513941329,"points":2,"id":15986672,"title":"Show HN: Network Monitor for iPhone and iPad"},"n_lab":0,"pos_pct":null,"neg_pct":null,"mood":null,"quotes":[{"id":15986672,"k":"ios:1289105991","type":"story","by":"Redfox9","time":1513941329,"text":"","title":"Show HN: Network Monitor for iPhone and iPad","story_id":15986672,"story_title":"Show HN: Network Monitor for iPhone and iPad","story_score":2,"comments":0,"w":1.585,"u":-1,"s":"pos","self":true}],"slug":"netmonitor"}